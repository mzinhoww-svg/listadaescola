# Copie para .env.local e preencha com os valores reais. Nunca commitar
# .env.local (já está no .gitignore do Next.js).
#
# Projeto Supabase desta etapa: listada-escola (ref wfdejmokxrunupsekcmq,
# sa-east-1). Pegue os valores atuais no dashboard do Supabase ou via
# mcp__Supabase__get_project_url / get_publishable_keys — não estão
# hardcoded aqui de propósito (ver docs/security/rls.md, seção Secrets).

# Publicável — chega ao browser. NEXT_PUBLIC_* é a única categoria que pode
# ser exposta no bundle do cliente (PRD SEC-004).
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-ou-publishable-key

# Server-only — NUNCA prefixar com NEXT_PUBLIC_, nunca referenciar em
# Client Components. Usado só em Server Actions/Route Handlers/scripts de
# importação.
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key

# Preenchido a partir do Prompt 05 (mapas/geocoding) — mantido aqui já
# como placeholder para o formato do arquivo ficar estável.
# GEOCODING_API_KEY=
