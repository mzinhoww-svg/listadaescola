# Copie para .env.local e preencha com os valores reais. Nunca commitar
# .env.local (já está no .gitignore do Next.js).
#
# Projeto Supabase desta etapa: listada-escola (ref wfdejmokxrunupsekcmq,
# sa-east-1). Pegue os valores atuais no dashboard do Supabase ou via
# mcp__Supabase__get_project_url / get_publishable_keys — não estão
# hardcoded aqui de propósito (ver docs/security/rls.md, seção Secrets).

# Publicável — chega ao browser. NEXT_PUBLIC_* é a única categoria que pode
# ser exposta no bundle do cliente (PRD SEC-004).
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-ou-publishable-key

# Server-only — NUNCA prefixar com NEXT_PUBLIC_, nunca referenciar em
# Client Components. Usado só em Server Actions/Route Handlers/scripts de
# importação.
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key

# Mapas (Prompt 05) -- todas opcionais. Sem elas, o mapa usa o raster OSM
# público como default (zero-config) e a busca por texto usa
# município-conhecido -> Nominatim público como fallback. Ver
# docs/architecture/mapas-localizacao.md.

# Publicável -- embutida na URL que o browser pede direto ao provider de
# tiles, então NEXT_PUBLIC_* é o prefixo certo aqui (diferente de uma
# chave de geocoding, que fica server-only abaixo). Aponte para uma
# style.json completa (ex.: MapTiler/Stadia/Protomaps com token) para
# substituir o raster OSM por padrão inteiramente.
# NEXT_PUBLIC_MAP_STYLE_URL=
# NEXT_PUBLIC_MAP_TILE_URL_TEMPLATE=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# NEXT_PUBLIC_MAP_ATTRIBUTION=

# Server-only -- reservada para um futuro provider de geocoding OSM-derived
# com chave (ex.: LocationIQ/Geoapify) substituindo o Nominatim público em
# src/lib/geocoding/nominatim.ts. Não é exigida hoje: CEP resolve via
# BrasilAPI/ViaCEP (gratuitos, sem chave) e cidade/bairro via município
# conhecido -> Nominatim público, ambos sem GEOCODING_API_KEY.
# GEOCODING_API_KEY=

# SEO (Prompt 15) -- publicável, usada em metadataBase (src/app/layout.tsx)
# e para montar URLs absolutas em JSON-LD (src/lib/seo/site-url.ts). Sem
# ela, cai para VERCEL_URL (preview) e por fim localhost -- funciona sem
# configurar nada, mas produção com domínio próprio precisa disto setado
# de verdade para OG image/canonical/JSON-LD resolverem para a URL real
# (não a de preview). Não afeta emailRedirectTo de auth -- aquele usa o
# host da requisição, não esta variável (ver getSiteUrl() em
# src/lib/auth/actions.ts).
# NEXT_PUBLIC_SITE_URL=https://listadaescola.com.br
